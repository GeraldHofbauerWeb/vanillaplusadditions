{
 "credit": "Vanilla Plus Additions — motion modelled after Fresh Animations",
 "animations": [
  {
   "var.r": "random(id)*pi*4",
   "var.t": "(time*pi*2)/6",
   "var.gait": "clamp(limb_speed*1.2, 0, 1)",
   "var.snap": "clamp(cos(var.r +var.t/15)*4 -3, 0, 1)",
   "var.snap2": "clamp(cos(pi/1.6 +var.r +var.t/17)*4 -3, 0, 1)",
   "var.peek": "clamp(cos(var.r +var.t/11)*5 -4, 0, 1)",
   "var.peek2": "clamp(cos(pi/2.2 +var.r +var.t/13)*5 -4, 0, 1)",
   "rightClaw.ry": "0.3926991 +torad(10)*var.snap",
   "leftClaw.ry": "-0.3926991 -torad(10)*var.snap2",
   "rightEye.rz": "torad(6)*var.peek*sin(var.t*0.5)",
   "leftEye.rz": "-torad(6)*var.peek2*sin(var.t*0.5 +0.7)",
   "rightEye.rx": "-0.3926991 +torad(4)*sin(var.r +var.t/4)",
   "leftEye.rx": "-0.3926991 +torad(4)*sin(var.r*1.3 +var.t/4.5)",
   "var.idle": "1 -var.gait",
   "leftLeg1.ry": "-0.43633232 +torad(4)*sin(var.t/3 +var.r +0.45)*var.idle",
   "leftLeg2.ry": "-0.21816616 +torad(4)*sin(var.t/3 +var.r +0.90)*var.idle",
   "leftLeg3.ry": "0.21816616 +torad(4)*sin(var.t/3 +var.r +1.35)*var.idle",
   "leftLeg4.ry": "0.43633232 +torad(4)*sin(var.t/3 +var.r +1.80)*var.idle",
   "rightLeg1.ry": "0.43633232 -torad(4)*sin(var.t/3 +var.r +2.05)*var.idle",
   "rightLeg2.ry": "0.21816616 -torad(4)*sin(var.t/3 +var.r +2.50)*var.idle",
   "rightLeg3.ry": "-0.21816616 -torad(4)*sin(var.t/3 +var.r +2.95)*var.idle",
   "rightLeg4.ry": "-0.43633232 -torad(4)*sin(var.t/3 +var.r +3.40)*var.idle"
  }
 ]
}
