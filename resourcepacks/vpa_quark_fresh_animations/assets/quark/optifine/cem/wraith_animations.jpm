{
 "credit": "Vanilla Plus Additions — motion modelled after Fresh Animations",
 "animations": [
  {
   "var.r": "random(id)*pi*4",
   "var.t": "(time*pi*2)/6",
   "var.gait": "clamp(limb_speed*1.2, 0, 1)",
   "arms.rz": "torad(4)*sin(var.r +var.t/9 -0.8)",
   "arms.ry": "torad(3)*sin(var.r*1.4 +var.t/11 -0.9)",
   "body.rx": "0.3927 +torad(2)*sin(var.r*1.4 +var.t/11)",
   "chain.rx": "torad(14)*sin(var.r +var.t/6 -0.6) +torad(5)*sin(var.t/2.3)",
   "var.look": "clamp(-head_yaw/40 +sin(var.r*1.3 +var.t/55)*1.2, -1.45, 1.45)",
   "r_pupil.tx": "3.0 +var.look",
   "l_pupil.tx": "-3.0 +var.look"
  }
 ]
}
