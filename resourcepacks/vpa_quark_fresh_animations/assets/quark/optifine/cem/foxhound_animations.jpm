{
 "credit": "Vanilla Plus Additions \u2014 Bewegungssprache an Fresh Animations angelehnt",
 "animations": [
  {
   "var.r": "random(id)*pi*4",
   "var.t": "(time*pi*2)/6",
   "var.gait": "clamp(limb_speed*1.2, 0, 1)",
   "var.ls": "limb_swing*0.6662",
   "var.twitch": "clamp(cos(var.r +var.t/18)*20 -19, 0, 1)",
   "var.twitch2": "clamp(cos(pi/1.7 +var.r +var.t/13)*16 -15, 0, 1)",
   "var.sniff": "clamp(cos(pi/2.3 +var.r +var.t/26)*26 -25, 0, 1)",
   "var.blink": "clamp(cos(var.r +var.t/40)*300 -299, 0, 1)",
   "var.wag": "clamp(cos(var.r +var.t/22)*8 -6, 0, 1)",
   "var.gaze": "clamp(cos(var.r +var.t/31)*6 -5, 0, 1)",
   "var.head_off": "head.ry -torad(head_yaw)",
   "var.eye_x": "clamp(-head_yaw/35 +var.head_off*1.1, -0.5, 0.5)",
   "var.eye_y": "clamp(head_pitch/90, -0.3, 0.3)",
   "var.look": "clamp(var.eye_x +sin(var.r*1.7 +var.t/90)*0.35*var.gaze, -0.5, 0.5)",
   "var.look2": "clamp(var.eye_y +sin(var.r*2.3 +var.t/140)*0.25*var.gaze, -0.35, 0.35)",
   "rightFrontLeg.rx": "if(is_sitting, 0, cos(var.ls)*1.0*limb_speed)",
   "leftFrontLeg.rx": "if(is_sitting, 0, cos(var.ls +pi)*1.0*limb_speed)",
   "rightBackLeg.rx": "if(is_sitting, -1.3089969, cos(var.ls +pi)*1.0*limb_speed)",
   "leftBackLeg.rx": "if(is_sitting, -1.3089969, cos(var.ls)*1.0*limb_speed)",
   "leftEar.rz": "torad(-9)*var.twitch  -torad(7)*var.gait",
   "rightEar.rz": "torad(9)*var.twitch2  +torad(7)*var.gait",
   "leftEar.rx": "torad(-6)*var.gait -torad(4)*var.twitch",
   "rightEar.rx": "torad(-6)*var.gait -torad(4)*var.twitch2",
   "snout.rx": "torad(4)*sin(var.t*1.2)*var.sniff*(1 -var.gait)",
   "tail.rz": "torad(if(is_tamed, 14, 6))*sin(var.t*0.45)*var.wag",
   "r_pupil.tx": "3.0 +var.look",
   "r_pupil.ty": "-8.5 +var.look2",
   "r_iris.sy": "1 -var.blink",
   "r_pupil.sy": "1 -var.blink",
   "r_iris.visible": "r_iris.sy!=0",
   "r_pupil.visible": "r_pupil.sy!=0",
   "l_pupil.tx": "-3.0 +var.look",
   "l_pupil.ty": "-8.5 +var.look2",
   "l_iris.sy": "1 -var.blink",
   "l_pupil.sy": "1 -var.blink",
   "l_iris.visible": "l_iris.sy!=0",
   "l_pupil.visible": "l_pupil.sy!=0"
  }
 ]
}
